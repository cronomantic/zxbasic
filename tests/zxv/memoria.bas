REM PEEK and POKE: the variables, and the ZX Spectrum memory below 64K
DIM v AS UINTEGER = 1234
DIM l AS ULONG
DIM p AS ULONG
DIM b AS UBYTE AT 23296
p = @v
PRINT PEEK(p); " "; PEEK(p + 1); " "; PEEK(UINTEGER, p)
POKE UINTEGER p, 4321
PRINT v
POKE ULONG @l, 305419896
PRINT l; " "; PEEK(@l)
POKE 16384, 255
PRINT PEEK 16384; " "; PEEK 16385
POKE 22528, 71
PRINT PEEK 22528
POKE 23296, 9
PRINT b; " "; PEEK 23296
b = b + 1
PRINT PEEK 23296
POKE UINTEGER 30001, 65535
PRINT PEEK(UINTEGER, 30001); " "; PEEK 30001; " "; PEEK 30002
PRINT PEEK 15616; " "; PEEK(15616 + 8 * 33 + 2)
PRINT PEEK(UINTEGER, 23606); " "; PEEK(UINTEGER, 23675)
