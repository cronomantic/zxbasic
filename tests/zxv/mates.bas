REM Math functions
DIM x AS FLOAT = 0.5
PRINT SIN(x); " "; COS(x); " "; TAN(x)
PRINT ASN(x); " "; ACS(x); " "; ATN(x)
PRINT EXP(1); " "; LN(10); " "; SQR(2)
PRINT PI; " "; 2 ^ 0.5; " "; (-2) ^ 3
PRINT 1E10 * 1.0; " "; 1 / 3.0; " "; CAST(FLOAT, 1) / 7
RANDOMIZE 1
PRINT INT(RND * 1000); " "; INT(RND * 1000); " "; INT(RND * 1000)
RANDOMIZE 1
PRINT INT(RND * 1000)
